{
  // Recommended VS Code workspace settings for Apache Spark development
  // These settings complement the devcontainer.json settings
  
  // Editor settings
  "editor.formatOnSave": false, // Disabled by default; Spark uses specific formatters
  "editor.rulers": [100], // Spark code style guide line length
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlayHints.enabled": "on",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "workbench.iconTheme": "material-icon-theme",
  "breadcrumbs.enabled": true,
  
  // Language-specific settings
  "[scala]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[java]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": false
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  },
  "[r]": {
    "editor.tabSize": 2
  },
  
  // Python settings
  "python.analysis.extraPaths": [
    "${workspaceFolder}/python"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/python"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.linting.flake8Args": [
    "--max-line-length=100",
    "--ignore=E402,E501,W503,W504"
  ],
  
  // Java settings
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.enabled": false,
  "java.saveActions.organizeImports": true,
  "java.compile.nullAnalysis.mode": "automatic",
  "java.sources.organizeImports.starThreshold": 99,
  "java.sources.organizeImports.staticStarThreshold": 99,
  "java.inlayHints.parameterNames.enabled": "all",
  
  // Scala/Metals settings
  "metals.javaHome": "/usr/lib/jvm/java-17-openjdk-amd64",
  "metals.sbtScript": "${workspaceFolder}/build/sbt",
  
  // Files to exclude from search/watch
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/.metals/**": true,
    "**/.bloop/**": true,
    "**/.ammonite/**": true,
    "**/work/**": true,
    "**/logs/**": true,
    "**/.m2/**": true,
    "**/.ivy2/**": true,
    "**/.sbt/**": true
  },
  
  "search.exclude": {
    "**/target": true,
    "**/.metals": true,
    "**/.bloop": true,
    "**/work": true,
    "**/logs": true,
    "**/.m2": true,
    "**/.ivy2": true,
    "**/.sbt": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  
  // Git settings
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableCommitSigning": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  
  // Terminal settings
  "terminal.integrated.env.linux": {
    "SPARK_HOME": "${workspaceFolder}"
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.tabs.enabled": true,
  
  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "python/pyspark"
  ],
  
  // Task runner
  "task.allowAutomaticTasks": "on",
  "task.problemMatchers.neverPrompt": false,
  
  // Security
  "security.workspace.trust.untrustedFiles": "open",
  
  // Performance
  "files.maxMemoryForLargeFilesMB": 4096,
  "search.maxResults": 20000,
  "search.smartCase": true,
  
  // Code Spell Checker
  "cSpell.words": [
    "pyspark",
    "sparkr",
    "mllib",
    "graphx",
    "pyarrow",
    "parquet",
    "avro",
    "hdfs",
    "yarn",
    "kubernetes",
    "databricks"
  ]
}
