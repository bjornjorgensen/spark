# EditorConfig helps maintain consistent coding styles across different editors
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,scala}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{r,R}]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{xml,html}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[pom.xml]
indent_style = space
indent_size = 2
