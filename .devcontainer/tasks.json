{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spark: Build (Skip Tests)",
      "type": "shell",
      "command": "./build/mvn",
      "args": [
        "-DskipTests",
        "clean",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Fast Build (Parallel)",
      "type": "shell",
      "command": "./build/mvn",
      "args": [
        "-T",
        "1C",
        "-DskipTests",
        "clean",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Build with Tests",
      "type": "shell",
      "command": "./build/mvn",
      "args": [
        "clean",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Clean",
      "type": "shell",
      "command": "./build/mvn",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Spark: Test Module",
      "type": "shell",
      "command": "./build/mvn",
      "args": [
        "test",
        "-pl",
        "${input:sparkModule}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Spark: Run Scala Shell",
      "type": "shell",
      "command": "./bin/spark-shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Run PySpark Shell",
      "type": "shell",
      "command": "./bin/pyspark",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Run SQL Shell",
      "type": "shell",
      "command": "./bin/spark-sql",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Spark: Run Example - SparkPi",
      "type": "shell",
      "command": "./bin/run-example",
      "args": [
        "SparkPi",
        "10"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint: Scala",
      "type": "shell",
      "command": "./dev/lint-scala",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint: Python",
      "type": "shell",
      "command": "./dev/lint-python",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint: Java",
      "type": "shell",
      "command": "./dev/lint-java",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint: R",
      "type": "shell",
      "command": "./dev/lint-r",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint: All",
      "dependsOn": [
        "Lint: Scala",
        "Lint: Python",
        "Lint: Java",
        "Lint: R"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Python: Run Tests",
      "type": "shell",
      "command": "./run-tests",
      "options": {
        "cwd": "${workspaceFolder}/python"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Python: Run Specific Test File",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "pytest",
        "${input:pythonTestFile}",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/python"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Docs: Build HTML",
      "type": "shell",
      "command": "make",
      "args": [
        "html"
      ],
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Serve Locally",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/docs/_build/html"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "sparkModule",
      "type": "pickString",
      "description": "Select Spark module to test",
      "options": [
        "core",
        "sql/core",
        "sql/catalyst",
        "sql/hive",
        "mllib",
        "mllib-local",
        "streaming",
        "graphx",
        "repl",
        "launcher",
        "examples"
      ],
      "default": "core"
    },
    {
      "id": "pythonTestFile",
      "type": "promptString",
      "description": "Enter Python test file path (relative to python/)",
      "default": "pyspark/sql/tests/test_dataframe.py"
    }
  ]
}
